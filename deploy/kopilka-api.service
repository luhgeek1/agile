[Unit]
Description=Kopilka FastAPI
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=kopilka
Group=kopilka
WorkingDirectory=/opt/kopilka/backend
EnvironmentFile=/etc/kopilka/api.env
ExecStartPre=/opt/kopilka/venv/bin/alembic upgrade head
ExecStart=/opt/kopilka/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8017 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
