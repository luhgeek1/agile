[Unit]
Description=Back up Kopilka PostgreSQL
After=postgresql.service

[Service]
Type=oneshot
User=postgres
UMask=0077
ExecStart=/bin/sh -ec '/usr/bin/pg_dump -Fc kopilka > /var/backups/kopilka/kopilka-$(date +%%Y-%%m-%%d-%%H%%M%%S).dump; find /var/backups/kopilka -name "kopilka-*.dump" -mtime +14 -delete'
