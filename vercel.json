{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kopilka.170.168.10.196.sslip.io/api/:path*"
    },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
